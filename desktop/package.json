{
  "name": "restrove-desktop",
  "version": "1.0.0",
  "description": "Restrove POS & Operations Platform - Windows Desktop Application",
  "main": "dist-electron/index.cjs",
  "author": "Restrove",
  "scripts": {
    "dev": "vite",
    "build": "npm run pack:ia32",
    "pack:ia32": "vite build && electron-packager . \"Chai Wala POS\" --platform=win32 --arch=ia32 --out=release-ia32 --overwrite --prune=true --asar --icon=assets/icon.ico --ignore=\"^/release.*\" --ignore=\"^/src\" --ignore=\"\\.zip$\"",
    "pack:x64": "vite build && electron-packager . \"Chai Wala POS\" --platform=win32 --arch=x64 --out=release-x64 --overwrite --prune=true --asar --icon=assets/icon.ico --ignore=\"^/release.*\" --ignore=\"^/src\" --ignore=\"\\.zip$\"",
    "build:installer": "vite build && electron-builder --win nsis --ia32 --publish never",
    "build:portable": "vite build && electron-builder --win portable --ia32 --publish never",
    "build:x64": "vite build && electron-builder --win nsis --x64 --publish never",
    "build:all": "vite build && electron-builder --win nsis --ia32 --x64 --publish never",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.restrove.chaiwala.pos",
    "productName": "Chai Wala POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chai Wala POS"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
