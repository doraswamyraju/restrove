{
  "name": "restrove-desktop",
  "version": "1.0.0",
  "description": "Restrove POS & Operations Platform - Windows Desktop Application",
  "main": "dist-electron/index.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-packager . \"Chai Wala POS\" --platform=win32 --arch=x64 --out=release --overwrite --prune=true",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.restrove.chaiwala.pos",
    "productName": "Chai Wala POS",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "dir"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
